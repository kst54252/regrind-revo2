<?xml version="1.0" ?>
<!-- A custom urdf with copilot generated -->
<robot name="screwdriver">
   <material name="obj_color">
      <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
   </material>
   <material name="obj_bottom_color">
      <color rgba="0.4 0.8 1.0 1.0"/>
   </material>
   <material name="obj_top_color">
      <color rgba="1.0 0.6 1.0 1.0"/>
   </material>
   <link name="bottom">
      <inertial>
         <origin rpy="0 0 0" xyz="0.000041 0.053778 -0.000280"/>
         <mass value="0.123329"/>
         <inertia ixx="0.0001629" ixy="0.0000001" ixz="0.0000000" iyy="0.0000120" iyz="0.0000000" izz="0.0001631"/>
      </inertial>
      <visual>
         <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver.obj" scale="1 1 1"/>
         </geometry>
         <material name="obj_color"/>
      </visual>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver_simplified/decomposed/screwdriver_simplified_000.obj" scale="1 1 1"/>
         </geometry>
      </collision>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver_simplified/decomposed/screwdriver_simplified_001.obj" scale="1 1 1"/>
         </geometry>
      </collision>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver_simplified/decomposed/screwdriver_simplified_002.obj" scale="1 1 1"/>
         </geometry>
      </collision>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver_simplified/decomposed/screwdriver_simplified_003.obj" scale="1 1 1"/>
         </geometry>
      </collision>
      <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
         <geometry>
            <mesh filename="screwdriver_simplified/decomposed/screwdriver_simplified_004.obj" scale="1 1 1"/>
         </geometry>
      </collision>
   </link>
</robot>
