    def Scope "Looks"
    {
        def Material "material_black"
        {
            token outputs:mdl:displacement.connect = </leap_right_hand/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:surface.connect = </leap_right_hand/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:volume.connect = </leap_right_hand/Looks/material_black/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.2, 0.2, 0.2)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.5
                float inputs:specular_level = 0.5
                token outputs:out
            }
        }
    }

