{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // For standalone script execution
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: List Envs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/list_envs.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Random Agent (LeapHand Scissors)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-LeapHand-Scissors-v0", "--num_envs", "16"],
            "program": "${workspaceFolder}/scripts/random_agent.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Train (LeapHand Scissors)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-LeapHand-Scissors-v0", "--num_envs", "2048", "--headless"],
            "program": "${workspaceFolder}/scripts/rsl_rl/train.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Play (LeapHand Scissors)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-LeapHand-Scissors-Play-v0", "--num_envs", "32"],
            "program": "${workspaceFolder}/scripts/rsl_rl/play.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Train (WujiHand Screwdriver)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-WujiHand-Screwdriver-v0", "--num_envs", "2048", "--headless"],
            "program": "${workspaceFolder}/scripts/rsl_rl/train.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Play (WujiHand Screwdriver)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-WujiHand-Screwdriver-Play-v0", "--num_envs", "32"],
            "program": "${workspaceFolder}/scripts/rsl_rl/play.py",
            "console": "integratedTerminal",
        },
        {
            "name": "Python: Replay Retargeted Traj",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/replay_retargeted_traj.py",
            "console": "integratedTerminal",
        },
        // For script execution inside a Docker
        {
            "name": "Docker: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}"
            }
        },
        {
            "name": "Docker: Train (LeapHand Scissors)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-LeapHand-Scissors-v0", "--num_envs", "2048", "--headless"],
            "program": "${workspaceFolder}/scripts/rsl_rl/train.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}"
            },
        },
        {
            "name": "Docker: Play (LeapHand Scissors)",
            "type": "debugpy",
            "request": "launch",
            "args": ["--task", "Regrind-LeapHand-Scissors-Play-v0", "--num_envs", "32"],
            "program": "${workspaceFolder}/scripts/rsl_rl/play.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${env:PYTHONPATH}:${workspaceFolder}"
            },
        },
    ]
}
